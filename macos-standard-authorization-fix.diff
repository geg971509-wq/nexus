diff --git a/src/sys/macos/MacOS.cpp b/src/sys/macos/MacOS.cpp
index 87bea476..c978c577 100644
--- a/src/sys/macos/MacOS.cpp
+++ b/src/sys/macos/MacOS.cpp
@@ -1,9 +1,26 @@
 #include <QFile>
-#include <QFileInfo>
+#include <QProcess>
+#include <QProcessEnvironment>
 #include <QString>
-#include <include/global/Utils.hpp>
+#include <sys/mount.h>
 
-int Mac_Run_Command(QString command) {
-    auto cmd = QString("osascript -e 'tell application \"Terminal\" to activate' -e 'tell application \"Terminal\" to do script \"%1\"' with administrator privileges").arg(command);
-    return system(cmd.toStdString().c_str());
+bool Mac_Core_Path_Supports_Setuid(const QString &path) {
+    struct statfs filesystem {};
+    const auto nativePath = QFile::encodeName(path);
+    return statfs(nativePath.constData(), &filesystem) == 0
+        && !(filesystem.f_flags & (MNT_NOSUID | MNT_IGNORE_OWNERSHIP));
+}
+
+int Mac_Set_Core_Permissions(const QString &path) {
+    QProcess process;
+    auto environment = QProcessEnvironment::systemEnvironment();
+    environment.insert("THRONE_CORE_PATH", path);
+    process.setProcessEnvironment(environment);
+    process.start("/usr/bin/osascript", {
+        "-e",
+        "set corePath to system attribute \"THRONE_CORE_PATH\"\n"
+        "do shell script (\"/usr/sbin/chown root:wheel \" & quoted form of corePath & \" && /bin/chmod u+s \" & quoted form of corePath) with administrator privileges"
+    });
+    if (!process.waitForFinished(-1)) return -1;
+    return process.exitCode();
 }
